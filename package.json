{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:android": "vite build && cap sync android",
    "cap:sync": "vite build && cap sync android",
    "cap:open": "cap open android",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "seed": "node tests/load/seed-data.js",
    "seed:dry": "node tests/load/seed-data.js --dry-run",
    "seed:clean": "node tests/load/seed-data.js --clean",
    "test:smoke": "k6 run tests/load/smoke-test.js",
    "test:load": "k6 run tests/load/load-test.js",
    "test:stress": "k6 run tests/load/stress-test.js",
    "test:soak": "k6 run tests/load/soak-test.js",
    "analyze": "node tests/load/analyze-results.js --all",
    "load:full": "npm run seed && npm run test:smoke && npm run analyze"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.5.0",
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.104.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.15.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^11.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "peerjs": "^1.5.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-example": "file:",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
