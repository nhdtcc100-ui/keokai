# ✅ Secret Management — Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# All keys are loaded from environment variables only (no hardcoding in source code).

# Supabase Configuration (required)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI Service (optional — Gemini API)
# ⚠️ SECURITY: In production, route Gemini calls through a Backend proxy (Supabase Edge Function)
# to prevent this key from being exposed in the client JavaScript bundle.
# See: https://supabase.com/docs/guides/functions
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (required if using Firebase Auth/Firestore/Storage)
# ⚠️ SECURITY: Do NOT commit firebase-applet-config.json. Use these env vars instead.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Observability & Monitoring (optional — Sentry Error Tracking)
VITE_SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id

# Load & Stress Testing (k6 environment variables — run with `k6 run -e SUPABASE_URL=...`)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key_here
